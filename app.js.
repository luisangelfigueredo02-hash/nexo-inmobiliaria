document.addEventListener("DOMContentLoaded", () => {
  console.log("NEXO app.js conectado correctamente.");

  const propertyGrid = document.getElementById("propertyGrid");

  if (!propertyGrid) {
    console.error("NEXO: no se encontró #propertyGrid");
    return;
  }

  /*
   * Por ahora mostramos el estado inicial.
   *
   * Más adelante esta función se conectará
   * a la API de NEXO → Cloudflare D1.
   */

  propertyGrid.innerHTML = `
    <div class="empty-state">
      <strong>NEXO está listo</strong>
      Estamos preparando las propiedades.
    </div>
  `;
});