                        </div>
                    `);
                    markersGroup.addLayer(marker);
                    validCoords.push([p.latitude, p.longitude]);
                }
            });

            if (validCoords.length > 0) {
                map.fitBounds(validCoords, { padding: [30, 30] });
            }
        }

        // Controladores de Vista
        document.getElementById("btn-grid").addEventListener("click", () => {
            document.getElementById("btn-grid").classList.add("active");
            document.getElementById("btn-map").classList.remove("active");
            document.getElementById("catalog").style.display = "grid";
            document.getElementById("map-view").style.display = "none";
        });

        document.getElementById("btn-map").addEventListener("click", () => {
            document.getElementById("btn-map").classList.add("active");
            document.getElementById("btn-grid").classList.remove("active");
            document.getElementById("catalog").style.display = "none";
            document.getElementById("map-view").style.display = "block";
            initMap();
            setTimeout(() => { map.invalidateSize(); }, 200);
        });

        // Eventos de Filtro
        document.querySelectorAll(".filters-container select, .filters-container input").forEach(el => {
            el.addEventListener("change", loadProperties);
        });

        // Control del CajÃ³n de Chat
        function toggleChat(show) {
            document.getElementById("chat-drawer").classList.toggle("open", show);
        }

        function handleChatKey(e) {
            if (e.key === "Enter") sendChatMessage();
        }

        async function sendChatMessage() {
            const input = document.getElementById("chat-input");
            const messageText = input.value.trim();
            if (!messageText) return;

            input.value = "";
            const messagesContainer = document.getElementById("chat-messages");

            // AÃ±adir mensaje del usuario
            const userMsg = document.createElement("div");
            userMsg.className = "msg user";
            userMsg.textContent = messageText;
            messagesContainer.appendChild(userMsg);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;

            // AÃ±adir indicador de escritura
            const typingMsg = document.createElement("div");
            typingMsg.className = "msg bot skeleton";
            typingMsg.style.width = "60px";
            typingMsg.style.height = "32px";
            messagesContainer.appendChild(typingMsg);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;

            try {
                const response = await fetch("/api/chat", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ message: messageText })
                });
                const data = await response.json();
                messagesContainer.removeChild(typingMsg);

                const botMsg = document.createElement("div");
                botMsg.className = "msg bot";
                
                // ExpresiÃ³n regular para capturar e interactuar con cÃ³digos de propiedades estructurados [N-XXX]
                let formattedResponse = data.response.replace(/\\n/g, "<br>");
                formattedResponse = formattedResponse.replace(/\[(N-\d{3})\]/g, (match, id) => {
                    return `<br><a href="/property.html?id=${id}" class="chat-property-link">Explorar Propiedad ${id} â†—</a>`;
                });

                botMsg.innerHTML = formattedResponse;
                messagesContainer.appendChild(botMsg);
            } catch (err) {
                messagesContainer.removeChild(typingMsg);
                const botMsg = document.createElement("div");
                botMsg.className = "msg bot";
                botMsg.textContent = "Lo siento, tuve un problema al conectarme con el servicio. Â¿PodrÃ­as volver a intentarlo?";
                messagesContainer.appendChild(botMsg);
            }
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        window.onload = loadProperties;
    </script>
