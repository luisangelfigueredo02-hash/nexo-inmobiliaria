    <script>
        let propertiesData = [];
        let map = null;
        let markersGroup = null;

        function showSkeletons() {
            const catalog = document.getElementById("catalog");
            catalog.innerHTML = Array(6).fill(0).map(() => `
                <div class="property-card" style="pointer-events: none;">
                    <div class="img-wrapper skeleton"></div>
                    <div class="card-info">
                        <div class="skeleton" style="height: 24px; width: 40%; border-radius: 4px;"></div>
                        <div class="skeleton" style="height: 18px; width: 80%; border-radius: 4px;"></div>
                        <div class="skeleton" style="height: 14px; width: 60%; border-radius: 4px;"></div>
                    </div>
                </div>
            `).join('');
        }

        async function loadProperties() {
            showSkeletons();
            const type = document.getElementById("filter-type").value;
            const op = document.getElementById("filter-operation").value;
            const prov = document.getElementById("filter-province").value;
            const price = document.getElementById("filter-price").value;

            let query = `/api/properties?`;
            if (type) query += `&type=${type}`;
            if (op) query += `&operation=${op}`;
            if (prov) query += `&province=${prov}`;
            if (price) query += `&maxPrice=${price}`;

            try {
                const response = await fetch(query);
                propertiesData = await response.json();
                renderCatalog();
                syncMapMarkers();
            } catch (err) {
                document.getElementById("catalog").innerHTML = `<p style="padding: 24px; text-align: center; color: var(--text-secondary);">Error al conectar con NEXO.</p>`;
            }
        }

        function renderCatalog() {
            const catalog = document.getElementById("catalog");
            if (propertiesData.length === 0) {
                catalog.innerHTML = `<p style="grid-column: 1/-1; padding: 48px; text-align: center; color: var(--text-secondary);">No hay inmuebles disponibles con estos filtros.</p>`;
                return;
            }

            catalog.innerHTML = propertiesData.map(p => {
                const mainImg = p.images[0] || "https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&q=80";
                return `
                    <a href="/property.html?id=${p.id}" class="property-card">
                        <div class="img-wrapper">
                            <span class="badge-op">${p.operation}</span>
                            <img src="${mainImg}" alt="${p.title}" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&q=80'">
                        </div>
                        <div class="card-info">
                            <div class="price">$${parseFloat(p.price).toLocaleString()} USD</div>
                            <div class="title">${p.title}</div>
                            <div class="loc">${p.neighborhood}, ${p.city}</div>
                            <div class="specs">
                                <span>ðŸ›ï¸ ${p.bedrooms}</span>
                                <span>ðŸ› ${p.bathrooms}</span>
                                <span>ðŸ“ ${p.area} mÂ²</span>
                            </div>
                        </div>
                    </a>
                `;
            }).join('');
        }

        function initMap() {
            if (map) return;
            map = L.map('map-view').setView([23.1136, -82.3666], 12);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);
            markersGroup = L.layerGroup().addTo(map);
        }

        function syncMapMarkers() {
            if (!map) return;
            markersGroup.clearLayers();
            const validCoords = [];

            propertiesData.forEach(p => {
                if (p.latitude && p.longitude) {
                    const marker = L.marker([p.latitude, p.longitude]);
                    const mainImg = p.images[0] || "https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&q=80";
                    marker.bindPopup(`
                        <div style="width: 150px; font-family:-apple-system, sans-serif;">
                            <img src="${mainImg}" style="width:100%; height:80px; object-fit:cover; border-radius:8px;">
                            <strong style="display:block; margin-top:6px;">$${parseFloat(p.price).toLocaleString()} USD</strong>
