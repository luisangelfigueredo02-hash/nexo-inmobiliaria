    <!-- Scripts de Leaflet -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        let adminProperties = [];
        let imageList = [];
        let mapAdmin = null;
        let selectedMarker = null;

        // Comprobar credenciales previamente validadas
        window.onload = () => {
            const savedToken = localStorage.getItem("nexo_admin_token");
            if (savedToken) {
                verifyTokenAndBootstrap(savedToken);
            }
        };

        async function verifyTokenAndBootstrap(token) {
            try {
                const response = await fetch("/api/admin/verify", {
                    method: "POST",
                    headers: { "Authorization": `Bearer ${token}` }
                });

                if (response.ok) {
                    localStorage.setItem("nexo_admin_token", token);
                    document.getElementById("login-box").style.display = "none";
                    document.getElementById("admin-panel").style.display = "flex";
                    initAdminMap();
                    loadAdminProperties();
                } else {
                    alert("Token de acceso denegado o vencido.");
                    logout();
                }
            } catch (err) {
                alert("Falla de red al verificar autenticidad.");
            }
        }

        function attemptLogin() {
            const token = document.getElementById("auth-token-input").value;
            if (token) verifyTokenAndBootstrap(token);
        }

        function logout() {
            localStorage.removeItem("nexo_admin_token");
            window.location.reload();
        }

        // 9. InicializaciÃ³n de mapa para configurar coordenadas con clics de precisiÃ³n
        function initAdminMap() {
            mapAdmin = L.map('admin-map').setView([23.1136, -82.3666], 12);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(mapAdmin);

            mapAdmin.on('click', (e) => {
                const { lat, lng } = e.latlng;
                document.getElementById("p-lat").value = lat.toFixed(6);
                document.getElementById("p-lng").value = lng.toFixed(6);

                if (selectedMarker) {
                    selectedMarker.setLatLng(e.latlng);
                } else {
                    selectedMarker = L.marker(e.latlng).addTo(mapAdmin);
                }
            });
        }

        // Manejador de GalerÃ­as (mÃºltiples fotos por propiedad)
        function addPhotoUrl() {
            const input = document.getElementById("p-new-photo");
            const url = input.value.trim();
            if (!url) return;

            imageList.push(url);
            input.value = "";
            renderPhotoThumbs();
        }

        function deletePhoto(index) {
            imageList.splice(index, 1);
            renderPhotoThumbs();
        }

        function renderPhotoThumbs() {
            const list = document.getElementById("p-photo-list");
            list.innerHTML = imageList.map((url, index) => `
                <div class="photo-thumb">
                    <img src="${url}">
                    <button type="button" class="del-btn" onclick="deletePhoto(${index})">Ã—</button>
                </div>
            `).join('');
        }

        // Carga de listado completo desde la API Administrativa (incluye datos privados)
        async function loadAdminProperties() {
            const token = localStorage.getItem("nexo_admin_token");
            try {
                const response = await fetch("/api/admin/properties", {
                    headers: { "Authorization": `Bearer ${token}` }
                });
                adminProperties = await response.json();
                renderAdminList();
            } catch (err) {
                console.error("Error al obtener listados administrativos", err);
            }
        }

        function renderAdminList() {
            const container = document.getElementById("admin-properties-list");
            if (adminProperties.length === 0) {
                container.innerHTML = `<p style="color:var(--text-secondary); text-align:center;">NingÃºn inmueble creado.</p>`;
                return;
            }

            container.innerHTML = adminProperties.map(p => `
                <div class="prop-item">
                    <div>
                        <strong>${p.id} â€” ${p.title}</strong>
                        <span style="font-size:12px; color:var(--text-secondary);">${p.neighborhood} â€¢ $${parseFloat(p.price).toLocaleString()} USD â€¢ Status: <b>${p.status}</b></span>
                    </div>
                    <div style="flex-direction:row; gap:8px;">
                        <button class="btn" style="padding:6px 12px; font-size:11px;" onclick="enableEditMode('${p.id}')">Editar</button>
                        <button class="btn danger" style="padding:6px 12px; font-size:11px;" onclick="deleteProperty('${p.id}')">Eliminar</button>
                    </div>
                </div>
            `).join('');
        }

        // Preparar formulario para modo EdiciÃ³n de Inmueble
        function enableEditMode(id) {
            const p = adminProperties.find(prop => prop.id === id);
            if (!p) return;

            document.getElementById("form-action-title").textContent = `Editar Inmueble ${p.id}`;
            document.getElementById("edit-id").value = p.id;
            document.getElementById("p-title").value = p.title;
            document.getElementById("p-type").value = p.type;
            document.getElementById("p-operation").value = p.operation;
            document.getElementById("p-price").value = p.price;
            document.getElementById("p-area").value = p.area;
            document.getElementById("p-beds").value = p.bedrooms;
            document.getElementById("p-baths").value = p.bathrooms;
            document.getElementById("p-province").value = p.province;
            document.getElementById("p-city").value = p.city;
            document.getElementById("p-neighborhood").value = p.neighborhood;
            document.getElementById("p-description").value = p.description;
            document.getElementById("p-address").value = p.address;
            document.getElementById("p-owner-name").value = p.owner_name;
            document.getElementById("p-owner-phone").value = p.owner_phone;
            document.getElementById("p-notes").value = p.internal_notes;
            document.getElementById("p-status").value = p.status;

            imageList = [...p.images];
            renderPhotoThumbs();

            if (p.latitude && p.longitude) {
                document.getElementById("p-lat").value = p.latitude;
                document.getElementById("p-lng").value = p.longitude;
                const coords = [p.latitude, p.longitude];
                mapAdmin.setView(coords, 15);
                if (selectedMarker) selectedMarker.setLatLng(coords);
                else selectedMarker = L.marker(coords).addTo(mapAdmin);
            } else {
                document.getElementById("p-lat").value = "";
                document.getElementById("p-lng").value = "";
                if (selectedMarker) {
                    mapAdmin.removeLayer(selectedMarker);
                    selectedMarker = null;
                }
            }

            document.getElementById("btn-cancel-edit").style.display = "inline-block";
        }

        function cancelEditMode() {
            document.getElementById("form-action-title").textContent = "Crear Propiedad";
            document.getElementById("prop-form").reset();
            document.getElementById("edit-id").value = "";
            document.getElementById("btn-cancel-edit").style.display = "none";
            imageList = [];
            renderPhotoThumbs();
            if (selectedMarker) {
                mapAdmin.removeLayer(selectedMarker);
                selectedMarker = null;
            }
        }

        // Manejador de Registro y ActualizaciÃ³n (Previene dobles envÃ­os)
        async function handleFormSubmit(e) {
            e.preventDefault();
            const saveBtn = document.getElementById("btn-save-submit");
            saveBtn.disabled = true;
            saveBtn.textContent = "Guardando...";

            const id = document.getElementById("edit-id").value;
            const token = localStorage.getItem("nexo_admin_token");

            const payload = {
                title: document.getElementById("p-title").value,
                type: document.getElementById("p-type").value,
                operation: document.getElementById("p-operation").value,
                price: parseFloat(document.getElementById("p-price").value),
                area: parseFloat(document.getElementById("p-area").value),
                bedrooms: parseInt(document.getElementById("p-beds").value),
                bathrooms: parseInt(document.getElementById("p-baths").value),
                province: document.getElementById("p-province").value,
                city: document.getElementById("p-city").value,
                neighborhood: document.getElementById("p-neighborhood").value,
                description: document.getElementById("p-description").value,
                images: imageList,
                latitude: parseFloat(document.getElementById("p-lat").value) || null,
                longitude: parseFloat(document.getElementById("p-lng").value) || null,
                address: document.getElementById("p-address").value,
                owner_name: document.getElementById("p-owner-name").value,
                owner_phone: document.getElementById("p-owner-phone").value,
                internal_notes: document.getElementById("p-notes").value,
                status: document.getElementById("p-status").value
            };

            const url = id ? `/api/admin/properties/${id}` : "/api/admin/properties";
            const method = id ? "PUT" : "POST";

            try {
                const response = await fetch(url, {
                    method: method,
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${token}`
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    alert("Propiedad procesada exitosamente.");
                    cancelEditMode();
                    loadAdminProperties();
                } else {
                    const err = await response.json();
                    alert(`Error: ${err.error}`);
                }
            } catch (err) {
                alert("Falla del servidor al guardar.");
            } finally {
                saveBtn.disabled = false;
                saveBtn.textContent = "Guardar Propiedad";
            }
        }

        // EliminaciÃ³n Segura de Inmuebles
        async function deleteProperty(id) {
            if (!confirm(`Â¿EstÃ¡ seguro de que desea eliminar la propiedad ${id}? Esta acciÃ³n es irreversible.`)) return;

            const token = localStorage.getItem("nexo_admin_token");
            try {
                const response = await fetch(`/api/admin/properties/${id}`, {
                    method: "DELETE",
                    headers: { "Authorization": `Bearer ${token}` }
                });

                if (response.ok) {
                    alert("Propiedad eliminada.");
                    loadAdminProperties();
                } else {
                    alert("Fallo al eliminar propiedad.");
                }
            } catch (err) {
                alert("Error de red.");
            }
        }
    </script>
</body>
</html>
