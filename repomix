    </style>
</head>
<body>

    <!-- Cabecera de NavegaciÃ³n Glass Premium -->
    <header class="glass-effect">
        <a href="/" class="logo">
            <svg viewBox="0 0 24 24">
                <path d="M12 3L2 12h3v8h14v-8h3L12 3zm2 15h-4v-4h4v4z"/>
            </svg>
            NEXO
        </a>
        <nav>
            <a href="/">Propiedades</a>
            <a href="/mapa/index.html" class="active">Mapa</a>
            <a href="/comparar/index.html">Comparar</a>
            <a href="/ia/index.html">Chat IA</a>
            <a href="/admin.html" style="border: 1px solid var(--border-default);">Admin</a>
        </nav>
    </header>

    <!-- Contenedor Principal de la Experiencia Dividida -->
    <main class="map-split-view">
        
        <!-- Ãrea del mapa (Izquierda) -->
        <section class="map-wrapper">
            <div id="fullscreen-map"></div>
            
            <!-- PrevisualizaciÃ³n flotante mÃ³vil -->
            <div class="mobile-preview-container" id="mobile-preview">
                <button class="close-preview-btn" onclick="closeMobilePreview()" aria-label="Cerrar previsualizaciÃ³n">
                    <svg viewBox="0 0 24 24" style="width: 14px; height: 14px; fill: currentColor;">
                        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                    </svg>
                </button>
                <div id="mobile-card-slot"></div>
            </div>
        </section>

        <!-- Panel Lateral del CatÃ¡logo de Propiedades (Derecha - Desktop) -->
        <aside class="sidebar-list">
            <div class="sidebar-header">
                <h1>Propiedades en el mapa</h1>
                <p id="visible-properties-count">Consultando catÃ¡logo...</p>
            </div>
            <div class="list-grid" id="properties-sidebar-grid">
                <!-- Skeletons iniciales de carga -->
                <div class="property-card shimmer-effect" style="height: 320px;"></div>
                <div class="property-card shimmer-effect" style="height: 320px;"></div>
            </div>
        </aside>

    </main>

    <!-- LibrerÃ­as JS de Leaflet para el motor geogrÃ¡fico -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    
    <!-- LÃ³gica de Enlace y Controladores -->
    <script>
        let map;
        let globalProperties = [];
        let markersGroup = [];
        const API_ENDPOINT = '/api/properties';

        document.addEventListener('DOMContentLoaded', () => {
            initializeMap();
            loadMapData();
        });

        // 1. Inicializar el mapa bloqueando captura de scroll hasta hacer foco explÃ­cito
        function initializeMap() {
            map = L.map('fullscreen-map', {
                scrollWheelZoom: false, // Evita atrapar el scroll de ratÃ³n en desktop
                touchZoom: true
            }).setView([-12.046374, -77.042793], 13); // Coordenadas de inicio genÃ©ricas

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            // Escuchar el movimiento del mapa para filtrar elementos en el listado
            map.on('moveend', filterSidebarProperties);
        }

        // 2. Cargar los datos de la base de datos de NEXO (D1)
        async function loadMapData() {
            try {
                const response = await fetch(API_ENDPOINT);
                if (!response.ok) throw new Error('Error al conectar con el catÃ¡logo.');

                globalProperties = await response.json();
                
                // Centrar dinÃ¡micamente el mapa en el promedio de propiedades si existen
                if (globalProperties.length > 0) {
                    const lats = globalProperties.map(p => parseFloat(p.latitude) || -12.046374);
                    const lngs = globalProperties.map(p => parseFloat(p.longitude) || -77.042793);
                    const avgLat = lats.reduce((a,b)=>a+b, 0) / lats.length;
                    const avgLng = lngs.reduce((a,b)=>a+b, 0) / lngs.length;
                    map.setView([avgLat, avgLng], 14);
                }

                plotMarkers();
                filterSidebarProperties();

            } catch (error) {
                console.error(error);
                document.getElementById('visible-properties-count').textContent = 'Error al cargar';
            }
        }

        // 3. Dibujar los marcadores de precio de estilo Airbnb
        function plotMarkers() {
            // Limpiar marcadores viejos
            markersGroup.forEach(m => map.removeLayer(m));
            markersGroup = [];

            globalProperties.forEach(property => {
                const lat = parseFloat(property.latitude);
                const lng = parseFloat(property.longitude);
                if (!lat || !lng) return;

                // Formatear precio compacto (ej: $150k en vez de $150,000 USD)
                const compactPrice = formatCompactPrice(property.price);

                // Crear un icono HTML personalizado (L.divIcon)
                const priceIcon = L.divIcon({
                    className: 'custom-leaflet-icon',
                    html: `<div class="price-marker" id="marker-${property.id}">${compactPrice}</div>`,
                    iconSize: [60, 30],
                    iconAnchor: [30, 15]
                });

                const marker = L.marker([lat, lng], { icon: priceIcon }).addTo(map);
                
                // Al hacer clic, gestionar comportamiento responsivo
                marker.on('click', () => {
                    handleMarkerClick(property);
                });

                // Registrar para manipulaciÃ³n posterior
                marker.propertyId = property.id;
                markersGroup.push(marker);
            });
        }

        // 4. Formateador compacto de precios (Tier 1 Standard)
        function formatCompactPrice(price) {
            if (price >= 1000000) {
                return `$${(price / 1000000).toFixed(1)}M`;
            }
            if (price >= 1000) {
                return `$${Math.round(price / 1000)}k`;
            }
            return `$${price}`;
        }

        // 5. Filtrar las tarjetas del sidebar mostrando solo las visibles en pantalla
        function filterSidebarProperties() {
            const bounds = map.getBounds();
            const sidebarGrid = document.getElementById('properties-sidebar-grid');
            const countLabel = document.getElementById('visible-properties-count');

            // Filtrar propiedades dentro del cuadrante actual
            const visibleProperties = globalProperties.filter(property => {
                const lat = parseFloat(property.latitude);
                const lng = parseFloat(property.longitude);
                if (!lat || !lng) return false;
                return bounds.contains([lat, lng]);
            });

            // Actualizar contador
            countLabel.textContent = `${visibleProperties.length} propiedades visibles`;

            // Renderizar listado de la barra lateral
            renderSidebarList(visibleProperties, sidebarGrid);
        }

        // 6. Pintar listado lateral interactivo
        function renderSidebarList(properties, container) {
            container.innerHTML = '';

            if (properties.length === 0) {
                container.innerHTML = `
                    <div style="grid-column: 1/-1; padding: var(--space-5) 0; text-align: center; color: var(--text-secondary); font-size: var(--text-sm);">
                        Mueve el mapa o reduce el zoom para encontrar propiedades en esta Ã¡rea.
                    </div>
                `;
                return;
            }

            properties.forEach(property => {
                const card = document.createElement('article');
                card.className = 'property-card';
                
                const formattedPrice = new Intl.NumberFormat('en-US', {
                    style: 'currency',
                    currency: 'USD',
                    maximumFractionDigits: 0
                }).format(property.price);

                card.innerHTML = `
                    <div class="image-container" style="aspect-ratio: 16/10;">
                        <span class="badge" style="font-size: 10px; padding: 2px 6px;">${property.type_transaction || 'Venta'}</span>
                        <img src="${property.image_url || 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=600&q=80'}" alt="${property.title}" loading="lazy">
                    </div>
                    <div class="details-container" style="padding: var(--space-3); gap: 4px;">
                        <div class="price" style="font-size: var(--text-md);">${formattedPrice}</div>
                        <h4 class="title" style="font-size: var(--text-sm);">${property.title}</h4>
                        <div class="location" style="font-size: var(--text-xs);">${property.location || 'UbicaciÃ³n'}</div>
                    </div>
                `;

                // InteracciÃ³n bidireccional (Hover de tarjeta activa pin)
                card.addEventListener('mouseenter', () => highlightMarker(property.id, true));
                card.addEventListener('mouseleave', () => highlightMarker(property.id, false));

                card.style.cursor = 'pointer';
                card.addEventListener('click', () => {
                    window.location.href = `/property.html?id=${property.id}`;
                });

                container.appendChild(card);
            });
        }

        // SincronizaciÃ³n del hover: Resalta el pin del mapa
        function highlightMarker(id, isActive) {
            const element = document.getElementById(`marker-${id}`);
            if (!element) return;
            if (isActive) {
                element.classList.add('active-marker');
            } else {
                element.classList.remove('active-marker');
            }
        }

        // 7. Gestionar clics en marcadores del mapa (Con previsualizaciÃ³n mÃ³vil)
        function handleMarkerClick(property) {
            // Desactivar marcas anteriores
            document.querySelectorAll('.price-marker').forEach(el => el.classList.remove('active-marker'));
            
            // Activar marca cliqueada
            highlightMarker(property.id, true);

            const isMobile = window.innerWidth <= 992;
            if (isMobile) {
                // Inyectar previsualizaciÃ³n mÃ³vil flotante estilo Airbnb
                const mobileSlot = document.getElementById('mobile-card-slot');
                const formattedPrice = new Intl.NumberFormat('en-US', {
                    style: 'currency', currency: 'USD', maximumFractionDigits: 0
                }).format(property.price);

                mobileSlot.innerHTML = `
                    <article class="property-card" onclick="window.location.href='/property.html?id=${property.id}'">
                        <div class="image-container">
                            <img src="${property.image_url || 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=600&q=80'}" alt="${property.title}">
                        </div>
                        <div class="details-container">
                            <div class="price">${formattedPrice}</div>
                            <h4 class="title">${property.title}</h4>
                            <div class="features-grid">
                                <div class="feature-item">
                                    <span>${property.bedrooms || 0}</span> habs
                                </div>
                                <div class="feature-item">
                                    <span>${property.area || 0}</span> mÂ²
                                </div>
                            </div>
                        </div>
                    </article>
                `;

                const previewContainer = document.getElementById('mobile-preview');
                previewContainer.classList.add('visible');
            } else {
                // En Desktop: Hacer scroll suave en el sidebar hasta encontrar la tarjeta
                const cards = document.querySelectorAll('#properties-sidebar-grid .property-card');
                cards.forEach(card => {
                    if (card.innerHTML.includes(property.title)) {
                        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        card.style.borderColor = 'var(--accent)';
                        setTimeout(() => card.style.borderColor = 'var(--border-subtle)', 2000);
                    }
                });
            }
        }

        // Cerrar previsualizaciÃ³n mÃ³vil
        function closeMobilePreview() {
            const previewContainer = document.getElementById('mobile-preview');
            previewContainer.classList.remove('visible');
            document.querySelectorAll('.price-marker').forEach(el => el.classList.remove('active-marker'));
        }
    </script>
</body>
</html>
